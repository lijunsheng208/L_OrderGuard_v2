{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orderguard.local/contracts/mcp/tool-result.schema.json",
  "title": "OrderGuard MCP Tool Result",
  "type": "object",
  "required": ["success", "source", "collected_at"],
  "properties": {
    "success": {"type": "boolean"},
    "data": {},
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "evidence_id": {"type": "string", "pattern": "^ev-[a-z0-9-]+$"},
    "source": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"success": {"const": true}}},
      "then": {"required": ["data", "evidence_id"]},
      "else": {"required": ["error"]}
    }
  ],
  "additionalProperties": false
}

